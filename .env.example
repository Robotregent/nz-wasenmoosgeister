# Storyblok → Settings → Access Tokens
# "Public"-Token: nur veröffentlichte Inhalte (Live-Seite)
STORYBLOK_DELIVERY_TOKEN=
# "Preview"-Token: auch Entwürfe (Visual Editor / Live-Preview)
STORYBLOK_PREVIEW_TOKEN=

# true = Entwürfe anzeigen + On-demand-Rendering für den Visual Editor – setzt "npm run dev:preview" automatisch
STORYBLOK_PREVIEW=false

# true = ohne Storyblok bauen, Inhalte aus scripts/seed/content.mjs (Demo / lokale Entwicklung)
STORYBLOK_OFFLINE=false

# Nur für "npm run seed": Personal Access Token (My Account → Account settings → Personal access token)
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=
# Nur Ziffern, ohne führendes "#"

# Lokales HTTPS (selbstsigniert, für den Visual Editor gegen localhost) – setzt "npm run dev:preview" automatisch
DEV_HTTPS=false

SITE_URL=https://nz-wasenmoosgeister-hoell.de
