# Storyblok → Settings → Access Tokens
# Production: "Public"-Token (nur veröffentlichte Inhalte). Preview-Deploy: "Preview"-Token (Entwürfe).
STORYBLOK_DELIVERY_TOKEN=

# true = Entwürfe anzeigen + On-demand-Rendering für den Visual Editor (nur Preview-Deploy / lokal)
STORYBLOK_PREVIEW=false

# true = ohne Storyblok bauen, Inhalte aus scripts/seed/content.mjs (Demo / lokale Entwicklung)
STORYBLOK_OFFLINE=false

# Nur für "npm run seed": Personal Access Token (My Account → Account settings → Personal access token)
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=

# Lokales HTTPS (für den Visual Editor gegen localhost)
DEV_HTTPS=false

SITE_URL=https://nz-wasenmoosgeister-hoell.de
