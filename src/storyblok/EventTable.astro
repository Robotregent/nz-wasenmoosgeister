---
import { storyblokEditable } from "@storyblok/astro";
import { fileExtension, formatDate, linkAttrs, parseDate } from "../lib/helpers";

const { block, editable } = Astro.props;

interface EventView {
  uid: string;
  editable: ReturnType<typeof storyblokEditable>;
  isoDay: string;
  weekday: string;
  day: string;
  dayNum: string;
  month: string;
  time: string;
  title: string;
  location: string;
  description: string;
  action?: { href: string; label: string; target?: string; rel?: string; download?: boolean; ext?: string };
}

const events: EventView[] = (block.events ?? [])
  .map((e: any) => {
    const date = parseDate(e.date);
    let action: EventView["action"];
    if (e.file?.filename) {
      const ext = fileExtension(e.file);
      action = {
        href: e.file.filename,
        label: e.action_label || "Download",
        target: "_blank",
        rel: "noopener",
        download: true,
        ext,
      };
    } else {
      const attrs = linkAttrs(e.link);
      if (attrs.href) action = { ...attrs, label: e.action_label || "Mehr Infos" };
    }
    return {
      uid: e._uid,
      editable: storyblokEditable(e),
      isoDay: e.date?.slice(0, 10) ?? "",
      weekday: date ? formatDate(date, { weekday: "short" }) : "",
      day: date ? formatDate(date, { day: "2-digit", month: "2-digit", year: "numeric" }) : "",
      dayNum: date ? formatDate(date, { day: "2-digit" }) : "",
      month: date ? formatDate(date, { month: "short" }).replace(".", "") : "",
      time: e.time_text ?? "",
      title: e.title ?? "",
      location: e.location ?? "",
      description: e.description ?? "",
      action,
    } satisfies EventView;
  })
  .sort((a: EventView, b: EventView) => a.isoDay.localeCompare(b.isoDay));

const showPast = block.show_past !== false;
const tableId = `events-${block._uid}`;
---

<section {...editable} class="container-page pt-12 sm:pt-16">
  {block.title && <h2 class="text-3xl font-semibold">{block.title}</h2>}
  {block.intro && <p class="mt-3 max-w-2xl text-bark-700">{block.intro}</p>}

  {
    events.length === 0 ? (
      <p class="mt-6 rounded-2xl border border-dashed border-bark-300 p-6 text-bark-700">
        Die Termine werden in Kürze veröffentlicht.
      </p>
    ) : (
      <div id={tableId} data-event-table data-show-past={String(showPast)} class="mt-8">
        {/* Desktop: Tabelle */}
        <div class="hidden overflow-hidden rounded-2xl border border-bark-200/70 bg-white/70 shadow-sm md:block">
          <table class="w-full text-left">
            <caption class="sr-only">{block.title || "Termine"}</caption>
            <thead class="bg-moss-800 text-sm text-linen">
              <tr>
                <th scope="col" class="px-5 py-3 font-semibold">Datum</th>
                <th scope="col" class="px-5 py-3 font-semibold">Uhrzeit</th>
                <th scope="col" class="px-5 py-3 font-semibold">Veranstaltung</th>
                <th scope="col" class="px-5 py-3 font-semibold">Ort</th>
                <th scope="col" class="px-5 py-3 text-right font-semibold">
                  <span class="sr-only">Link / </span>Infos
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-bark-100">
              {events.map((e) => (
                <tr {...e.editable} data-event-day={e.isoDay} class="align-top transition-colors hover:bg-moss-50/60">
                  <td class="px-5 py-4 whitespace-nowrap">
                    <span class="font-semibold text-bark-900">{e.weekday}</span>{" "}
                    <time datetime={e.isoDay}>{e.day}</time>
                  </td>
                  <td class="px-5 py-4 whitespace-nowrap text-bark-700">{e.time}</td>
                  <td class="px-5 py-4">
                    <span class="font-semibold text-bark-900">{e.title}</span>
                    {e.description && <p class="mt-1 text-sm text-bark-600">{e.description}</p>}
                    <span data-past-badge hidden class="mt-1 inline-block rounded-full bg-sand px-2 py-0.5 text-xs text-bark-600">
                      vorbei
                    </span>
                  </td>
                  <td class="px-5 py-4 text-bark-700">{e.location}</td>
                  <td class="px-5 py-4 text-right">
                    {e.action ? (
                      <a
                        href={e.action.href}
                        target={e.action.target}
                        rel={e.action.rel}
                        download={e.action.download ? "" : undefined}
                        class={e.action.download ? "btn-accent whitespace-nowrap" : "btn-secondary whitespace-nowrap"}
                      >
                        {e.action.download ? "↓" : "→"} {e.action.label}
                        {e.action.ext && <span class="text-xs opacity-70">({e.action.ext})</span>}
                      </a>
                    ) : (
                      <span class="text-bark-300" aria-label="keine weiteren Infos">–</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Mobil: Karten */}
        <ol class="space-y-4 md:hidden" role="list">
          {events.map((e) => (
            <li
              {...e.editable}
              data-event-day={e.isoDay}
              class="flex gap-4 rounded-2xl border border-bark-200/70 bg-white/70 p-4 shadow-sm"
            >
              <div class="flex w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-moss-800 py-2 text-linen">
                <span class="text-xs tracking-wide uppercase">{e.weekday}</span>
                <span class="font-serif text-2xl leading-none font-semibold">{e.dayNum}</span>
                <span class="text-xs">{e.month}</span>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold">{e.title}</h3>
                <p class="mt-0.5 text-sm text-bark-600">
                  <time datetime={e.isoDay}>{e.day}</time>
                  {e.time && <> · {e.time}</>}
                  {e.location && <> · {e.location}</>}
                </p>
                {e.description && <p class="mt-1 text-sm text-bark-700">{e.description}</p>}
                <span data-past-badge hidden class="mt-1 inline-block rounded-full bg-sand px-2 py-0.5 text-xs text-bark-600">
                  vorbei
                </span>
                {e.action && (
                  <a
                    href={e.action.href}
                    target={e.action.target}
                    rel={e.action.rel}
                    download={e.action.download ? "" : undefined}
                    class={`${e.action.download ? "btn-accent" : "btn-secondary"} mt-3 !px-4 !py-2`}
                  >
                    {e.action.download ? "↓" : "→"} {e.action.label}
                    {e.action.ext && <span class="text-xs opacity-70">({e.action.ext})</span>}
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</section>

<script>
  // Vergangene Termine im Browser markieren bzw. ausblenden – die Seite ist statisch
  // gebaut, das aktuelle Datum muss also clientseitig ausgewertet werden.
  function markPastEvents() {
    const today = new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Berlin" }).format(new Date());
    document.querySelectorAll<HTMLElement>("[data-event-table]").forEach((table) => {
      const showPast = table.dataset.showPast !== "false";
      table.querySelectorAll<HTMLElement>("[data-event-day]").forEach((row) => {
        const past = !!row.dataset.eventDay && row.dataset.eventDay < today;
        row.classList.toggle("opacity-55", past && showPast);
        row.hidden = past && !showPast;
        row.querySelector<HTMLElement>("[data-past-badge]")?.toggleAttribute("hidden", !past);
      });
    });
  }
  markPastEvents();
  document.addEventListener("storyblok-live-preview-updated", markPastEvents);
</script>
