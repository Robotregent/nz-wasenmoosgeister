---
import { imageUrl, linkAttrs } from "../lib/helpers";

const { block, editable } = Astro.props;
const attrs = linkAttrs(block.link);
const src = imageUrl(block.image, 800, 500) || "/placeholders/moor.svg";
---

<article
  {...editable}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-bark-200/70 bg-white/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
>
  <img src={src} alt={block.image?.alt ?? ""} width="800" height="500" loading="lazy" class="aspect-[16/10] w-full object-cover" />
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-semibold">
      {
        attrs.href ? (
          <a {...attrs} class="after:absolute after:inset-0 focus-visible:outline-none">
            {block.title}
          </a>
        ) : (
          block.title
        )
      }
    </h3>
    {block.text && <p class="mt-2 text-bark-700">{block.text}</p>}
    {
      attrs.href && (
        <span aria-hidden="true" class="mt-auto pt-4 text-sm font-semibold text-moss-700 group-hover:text-moss-900">
          Mehr erfahren →
        </span>
      )
    }
  </div>
</article>
