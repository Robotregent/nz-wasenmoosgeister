---
import { linkAttrs } from "../lib/helpers";

const { block, editable } = Astro.props;
const attrs = linkAttrs(block.link);
---

<li {...editable}>
  <a
    {...attrs}
    class="group flex h-full items-start justify-between gap-4 rounded-2xl border border-bark-200/70 bg-white/70 p-5 shadow-sm transition hover:border-moss-400 hover:bg-white"
  >
    <span>
      <span class="block font-semibold text-bark-900 group-hover:text-moss-800">{block.label}</span>
      {block.description && <span class="mt-1 block text-sm break-all text-bark-600">{block.description}</span>}
    </span>
    <span aria-hidden="true" class="text-moss-600 transition group-hover:translate-x-0.5">↗</span>
    {attrs.target && <span class="sr-only">(öffnet in neuem Tab)</span>}
  </a>
</li>
